# Provedor de LLM para síntese de contexto: none | ollama | openai
NOETRA_LLM_PROVIDER=none

# Modelo utilizado na síntese (ex: llama3.2, qwen2.5-coder, gpt-4o-mini)
NOETRA_LLM_MODEL=llama3.2

# Endpoint do Ollama (quando NOETRA_LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434

# Chave e endpoint OpenAI-compatible (quando NOETRA_LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
